# Isolated test stack config — copy to env/.test.env to use.
# scripts/test-stack.sh loads this file via `docker compose --env-file`.

# --- ports (host side; the containers' internal ports are unchanged) ---
POSTGRES_PORT=5433
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
QDRANT_HTTP_PORT=6336
QDRANT_GRPC_PORT=6337
MCP_PORT=8091

# --- volume bind-mount paths (ephemeral test data lives here) ---
PG_DATA_DIR=./data/test/postgres
NEO4J_DATA_DIR=./data/test/neo4j
QDRANT_DATA_DIR=./data/test/qdrant

# --- credentials (test stack only — keep simple, don't reuse dev secrets) ---
POSTGRES_USER=pearscarf
POSTGRES_PASSWORD=pearscarf_test
POSTGRES_DB=pearscarf_test
NEO4J_PASSWORD=password

# --- python-side connection vars (pytest reads these via dotenv) ---
POSTGRES_HOST=localhost
NEO4J_URL=bolt://localhost:7688
NEO4J_USER=neo4j
QDRANT_URL=http://localhost:6336

# --- model + auth (stub values are fine for migration-style tests that
#     don't actually hit Anthropic; real values needed only for tests that
#     exercise LLM-calling code paths) ---
ANTHROPIC_API_KEY=sk-test-placeholder
MODEL=claude-sonnet-4-5-20250929
TIMEZONE=America/Los_Angeles
