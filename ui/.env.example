# pearscarf-ui — environment variables
#
# Reads pearscarf's Postgres directly. In production, set DATABASE_URL to the
# in-network Postgres service (e.g. `postgres://pearscarf:...@db:5432/pearscarf`
# when running alongside pearscarf in the same docker-compose stack). For local
# dev against an installed pearscarf, point at the host-exposed port (typically
# 35432 — see pearscarf's `.env` after install).

DATABASE_URL=postgres://pearscarf:pearscarf@localhost:35432/pearscarf

# Pearscarf's Neo4j graph (read-only). Same auth as pearscarf's own server-side
# config. Default bolt port is 7687 on the pearscarf host; map a local port
# however you reach it, or point at any reachable Neo4j you have.
NEO4J_URL=bolt://localhost:37687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional. Refresh interval for the client-side polling (ms). Default 4000.
# NEXT_PUBLIC_POLL_INTERVAL_MS=4000

# Optional. Page-size cap. Default 100 for both intents and llm-calls.
# PAGE_SIZE=100
